<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>it</string>
	<key>CFBundleDisplayName</key><string>Volante</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchScreen</key><dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UIBackgroundModes</key>
	<array><string>audio</string><string>location</string></array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Per il coach di guida e la scatola nera: velocità, frenate e percorso restano sul telefono.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Per registrare il viaggio anche con la navigazione in primo piano.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Per registrare le note vocali con un tasto del volante mentre guidi.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Per trascrivere le note vocali sul dispositivo, senza inviarle a nessuno.</string>
	<key>NSMotionUsageDescription</key>
	<string>Per capire quando stai facendo una manovra e stare zitto invece di parlarti addosso.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Per creare eventi quando glielo chiedi a voce mentre guidi.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Per leggerti l'agenda ad alta voce quando la chiedi.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Per creare promemoria quando glieli detti mentre guidi.</string>
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<key>NSAppTransportSecurity</key>
	<dict><key>NSAllowsArbitraryLoads</key><true/></dict>
</dict>
</plist>
